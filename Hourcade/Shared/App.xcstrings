    "Nintendo 会话已过期或无效，请重新登录": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Nintendo session has expired or is invalid. Sign in again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nintendo 会话已过期或无效，请重新登录"
          }
        }
      }
    },
    "Nintendo 服务暂时不可用，请稍后重试": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nintendo services are temporarily unavailable. Try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nintendo 服务暂时不可用，请稍后重试"
          }
        }
      }
    },
    "Nintendo 登录回调验证失败，请重新登录": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nintendo sign-in callback validation failed. Sign in again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nintendo 登录回调验证失败，请重新登录"
          }
        }
      }
    },
    "Nintendo 登录完成，但没有返回授权码": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nintendo sign-in finished without returning an authorization code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Nintendo 登录完成，但没有返回授权码"
          }
        }
      }
    },
    "Nintendo 登录已在进行中，请先完成或取消当前登录": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nintendo sign-in is already in progress. Complete or cancel it first."
