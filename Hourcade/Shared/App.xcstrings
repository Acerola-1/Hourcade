    "HOURCADE · 你的游戏生活": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HOURCADE · YOUR GAME LIFE"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HOURCADE · 你的游戏生活"
          }
        }
      }
    },
    "Hourcade 驻留菜单栏并定时同步组件数据，不占用 Dock；随时可从菜单栏退出。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hourcade stays in the menu bar and refreshes widget data on a schedule; it never appears in the Dock. Quit anytime from the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hourcade 驻留菜单栏并定时同步组件数据，不占用 Dock；随时可从菜单栏退出。"
          }
        }
      }
    },
